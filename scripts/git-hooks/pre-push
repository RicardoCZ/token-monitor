#!/bin/sh
# 禁止推送包含「当前 .gitignore 会忽略」的路径的提交（与 pre-commit 一致）。
remote="$1"
url="$2"
z40=0000000000000000000000000000000000000000

while read local_ref local_sha remote_ref remote_sha
do
	case $local_sha in
		$z40) continue ;;
	esac
	if [ "$remote_sha" = "$z40" ]; then
		range="$local_sha"
	else
		range="$remote_sha..$local_sha"
	fi
	for commit in $(git rev-list $range 2>/dev/null)
	do
		names=$(git diff-tree --no-commit-id --name-only -r "$commit" 2>/dev/null | while IFS= read -r f; do
			[ -z "$f" ] && continue
			if git check-ignore -q "$f" 2>/dev/null; then
				printf '%s\n' "$f"
			fi
		done)
		if [ -n "$names" ]; then
			printf '%s\n' "" "拒绝推送：提交 $commit 包含被 .gitignore 忽略的路径：" "$names" "" "请从历史中移除相关文件或重写分支（此类路径不应入库）。" >&2
			exit 1
		fi
	done
done
exit 0
