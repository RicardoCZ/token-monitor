# Token Monitor 配置示例
# 复制为 backend/.env 并填写；backend/.env 已加入 .gitignore，勿提交。

# ============ 安全配置（必填）============
# JWT 签名（至少 16 字符，建议 32+ 随机串）
JWT_SECRET_KEY=

# 应用加密密钥，用于 Cookie 等（建议 32+ 随机串）
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=

# 预留，可选
# API_KEY=

# ============ MySQL（必填）============
DB_HOST=localhost
DB_PORT=3306
DB_NAME=token_monitor
DB_USER=tm_user
DB_PASSWORD=

# ============ 服务配置 ============
HOST=0.0.0.0
PORT=5188
DEBUG=false

# ============ 目录配置 ============
COOKIE_DIR=data

# ============ CDP（可选，用于 MiniMax 订阅截止日期抓取，与 Chrome 远程调试一致）============
# CDP_HOST=127.0.0.1
# CDP_PORT=9223
