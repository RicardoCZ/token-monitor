# Token Monitor 配置示例
# 复制为 backend/.env 并填写；backend/.env 已加入 .gitignore，勿提交。

# ============ 安全配置（必填）============
# JWT 签名（至少 16 字符，建议 32+ 随机串）
JWT_SECRET_KEY=

# 应用加密密钥，用于 Cookie 等（建议 32+ 随机串）
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=

# 预留，可选
# API_KEY=

# ============ MySQL（必填）============
DB_HOST=localhost
DB_PORT=3306
DB_NAME=token_monitor
DB_USER=tm_user
DB_PASSWORD=

# ============ 服务配置 ============
HOST=0.0.0.0
PORT=5188
DEBUG=false

# ============ 目录配置 ============
COOKIE_DIR=data

# ============ 自动采集（P2-2）============
# 是否启用后台自动采集（开发环境可设为 false）
AUTO_COLLECT_ENABLED=true
# 采集轮询间隔（秒），默认 300 = 5 分钟
AUTO_COLLECT_INTERVAL_SECONDS=300
# 单轮最大并发账号数
AUTO_COLLECT_MAX_CONCURRENCY=3
# 单账号采集总尝试次数（含首次）
AUTO_COLLECT_RETRY_ATTEMPTS=2
# 重试退避秒数
AUTO_COLLECT_RETRY_DELAY_SECONDS=1.0

# ============ 告警评估（P2-3）============
# 是否启用 snapshots 告警评估
ALERT_EVAL_ENABLED=true
# 默认阈值（百分比）
ALERT_DEFAULT_THRESHOLD=80
# 默认冷却秒数（1800=30分钟）
ALERT_DEFAULT_COOLDOWN_SECONDS=1800

# ============ CDP（可选，用于 MiniMax 订阅截止日期抓取，与 Chrome 远程调试一致）============
# CDP_HOST=127.0.0.1
# CDP_PORT=9223
